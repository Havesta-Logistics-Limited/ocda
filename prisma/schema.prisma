// Prisma schema for the OCDA website.
// Production (Netlify) uses Postgres via Netlify DB. Local dev needs a
// Postgres DATABASE_URL too now — point .env at the same Netlify DB
// connection string, or run Postgres locally.
//
// DATABASE_URL must be the pooled (PgBouncer) connection — serverless
// functions open a fresh connection per invocation, and Neon's direct
// connection has a low concurrent-connection cap that this blows through
// under any real traffic, causing requests to queue up and get slower the
// more of them land close together. DIRECT_URL is the unpooled connection,
// used only for `prisma migrate` (PgBouncer's transaction pooling mode
// doesn't support the session-level features migrations need).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A single admin (or a handful of staff) who can edit the site.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

// Generic editable content for pages/sections that are single instances
// (hero, mission, footer, contact info, ...). `data` holds a JSON blob
// whose shape is defined per-key in src/lib/content-schema.ts.
model SiteContent {
  key       String   @id
  data      String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// News posts and events (one collection, filterable by kind).
model Post {
  id            String    @id @default(cuid())
  kind          String // "news" | "event"
  slug          String    @unique
  title         String
  excerpt       String
  body          String
  coverImageUrl String?
  eventDate     DateTime?
  eventLocation String?
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

// Backing store for images uploaded from the admin dashboard, served via
// /api/uploads/[id]. Keeps the app self-contained with no object-storage
// credentials required to get started.
model Upload {
  id        String   @id @default(cuid())
  mimeType  String
  bytes     Bytes
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
