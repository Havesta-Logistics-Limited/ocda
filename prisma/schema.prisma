// Prisma schema for the OCDA website.
// Local dev uses SQLite (zero setup). For a serverless production host
// (e.g. Vercel), switch `provider` below to "postgresql", point
// DATABASE_URL at a hosted Postgres instance (Neon works well on the free
// tier), then run `npx prisma migrate dev` again — see README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A single admin (or a handful of staff) who can edit the site.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

// Generic editable content for pages/sections that are single instances
// (hero, mission, footer, contact info, ...). `data` holds a JSON blob
// whose shape is defined per-key in src/lib/content-schema.ts.
model SiteContent {
  key       String   @id
  data      String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// News posts and events (one collection, filterable by kind).
model Post {
  id            String    @id @default(cuid())
  kind          String // "news" | "event"
  slug          String    @unique
  title         String
  excerpt       String
  body          String
  coverImageUrl String?
  eventDate     DateTime?
  eventLocation String?
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

// Backing store for images uploaded from the admin dashboard, served via
// /api/uploads/[id]. Keeps the app self-contained with no object-storage
// credentials required to get started.
model Upload {
  id        String   @id @default(cuid())
  mimeType  String
  bytes     Bytes
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
