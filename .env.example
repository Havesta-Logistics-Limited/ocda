# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection strings (Netlify DB / Neon / Supabase all work).
# DATABASE_URL: the POOLED connection (PgBouncer) — what the app uses at
# runtime. On Neon-backed databases (including Netlify DB) this is the
# same host with "-pooler" inserted right before the first "." plus
# &pgbouncer=true on the query string.
# DIRECT_URL: the regular unpooled connection — used only for migrations.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech:5432/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech:5432/dbname?sslmode=require"

# Random string used to sign admin login sessions. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32+-character-secret"
