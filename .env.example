# Copy this file to .env and fill in real values. Never commit .env.

# Local dev: SQLite, zero setup.
# Production (serverless, e.g. Vercel): use a hosted Postgres URL (Neon,
# Supabase, etc.) and switch `provider` in prisma/schema.prisma from
# "sqlite" to "postgresql" — see README.md.
DATABASE_URL="file:./dev.db"

# Random string used to sign admin login sessions. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32+-character-secret"
