# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Netlify DB / Neon / Supabase all work).
# For local dev, point this at the same database Netlify DB provisioned
# for you, or run Postgres locally — see README.md.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random string used to sign admin login sessions. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32+-character-secret"
